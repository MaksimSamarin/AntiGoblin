# Local credentials for AntiGoblin dev scripts. Copy to `.env` and fill in.
# NEVER commit the real `.env` — it's in .gitignore.
#
# Sourced by scripts/xkeen/_load-env.ps1 and scripts/xkeen/router_ssh.py.
# All *.ps1 in scripts/xkeen/ read these when running deploy/start/stop.

# Required — SSH password to the router's Web UI / SSH account (admin user).
ROUTER_SSH_PASSWORD=change-me

# Optional — LAN IP where the Keenetic sits, default 192.168.1.1.
ROUTER_HOST=192.168.1.1

# Optional — SSH user on the router, default root.
ROUTER_SSH_USER=root

# Optional — SSH port on the router, default 22.
ROUTER_SSH_PORT=22

# Optional — TCP port for the AntiGoblin UI (uhttpd), default 8899.
# Persisted to /opt/etc/antigoblin.conf on the router for reboot-survival.
ANTIGOBLIN_UI_PORT=8899
